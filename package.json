{
	"name": "obsidian-cloudbridge",
	"version": "1.0.2",
	"description": "Sync Obsidian vault to any cloud via CloudBridge",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
